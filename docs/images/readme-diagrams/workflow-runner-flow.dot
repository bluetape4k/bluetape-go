digraph G {

graph [
  bgcolor="#F8FAFC",
  pad="0.28",
  nodesep="0.62",
  ranksep="0.78",
  splines=ortho,
  fontname="Comic Mono",
  fontsize=15,
  labelloc=t,
  labeljust=c
];
node [
  shape=box,
  style="rounded,filled",
  penwidth=1.8,
  margin="0.13,0.10",
  fontname="Comic Mono",
  fontsize=12,
  color="#CBD5E1",
  fillcolor="white",
  fontcolor="#1E293B"
];
edge [
  color="#475569",
  penwidth=2.0,
  arrowsize=0.8,
  fontname="Comic Mono",
  fontsize=11,
  fontcolor="#334155"
];

graph [rankdir=LR, label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>workflow - Runner Flow</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">source-grounded README diagram</FONT>>];

caller [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Caller</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">context.Context</FONT>> fillcolor="#EBF4FF" color="#93C5FD"];
runner [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Runner</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">Run(ctx) -&gt; Report</FONT>> fillcolor="#FAF5FF" color="#C4B5FD"];
sequential [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Sequential</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">input order</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">policy decides stop</FONT>> fillcolor="#F0F9FF" color="#7DD3FC"];
conditional [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Conditional</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">predicate once</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">one selected branch</FONT>> fillcolor="#F0FDF4" color="#86EFAC"];
parallel [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Parallel</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">shared cancellable ctx</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">preserve child order</FONT>> fillcolor="#FFF7ED" color="#FCD34D"];
aggregate [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>workreport.Aggregate</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">child reports + policy</FONT>> fillcolor="#FEF9C3" color="#FDE047"];
report [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Parent Report</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">completed / partial</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">failed / cancelled</FONT>> fillcolor="#FFF1F2" color="#FDA4AF"];
cancel [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Cancellation</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">ctx error stops work</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">parallel cancels siblings</FONT>> fillcolor="#FEE2E2" color="#FCA5A5"];

caller -> runner;
runner -> sequential;
runner -> conditional;
runner -> parallel;
sequential -> aggregate;
conditional -> aggregate;
parallel -> aggregate;
aggregate -> report;
caller -> cancel [color="#EF4444" fontcolor="#B91C1C"];
parallel -> cancel [color="#EF4444" fontcolor="#B91C1C"];
cancel -> report [color="#EF4444" fontcolor="#B91C1C"];

}
