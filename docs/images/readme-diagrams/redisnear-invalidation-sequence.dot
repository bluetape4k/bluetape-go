process_a [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Process A</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">NearCache local values</FONT>> fillcolor="#EBF4FF" color="#93C5FD"];
redis [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Redis Pub/Sub</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">channel per namespace</FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">invalidation bus only</FONT>> fillcolor="#FFF7ED" color="#FCD34D"];
process_b [label=<<FONT FACE="Architects Daughter" POINT-SIZE="18"><B>Process B</B></FONT><BR/><FONT FACE="Comic Mono" POINT-SIZE="11">NearCache local values</FONT>> fillcolor="#EBF4FF" color="#93C5FD"];
