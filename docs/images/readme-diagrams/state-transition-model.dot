digraph StateTransitionModel {
  graph [
    rankdir=LR,
    bgcolor="#F8FAFC",
    pad=0.35,
    nodesep=0.6,
    ranksep=0.7,
    fontname="Comic Mono"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#93C5FD",
    fillcolor="white",
    fontname="Comic Mono",
    fontsize=12,
    margin="0.14,0.10"
  ];
  edge [
    color="#475569",
    fontname="Comic Mono",
    fontsize=10,
    arrowsize=0.8
  ];

  machine [label="Machine[S,E]\ncurrent state + registry", fillcolor="#EBF4FF"];
  created [label="created\ninitial"];
  paid [label="paid"];
  shipped [label="shipped\nfinal", fillcolor="#F0FFF4", color="#6EE7B7"];
  cancelled [label="cancelled\nfinal", fillcolor="#FFF7ED", color="#FCD34D"];
  guard [label="optional Guard\nctx, from, event", fillcolor="#FAF5FF", color="#C4B5FD"];
  errors [label="TransitionError\nerrors.Is sentinels", fillcolor="#FFF1F2", color="#FDA4AF"];

  machine -> created [label="State()"];
  created -> guard [label="event: pay"];
  guard -> paid [label="allow"];
  paid -> shipped [label="event: ship"];
  created -> cancelled [label="event: cancel"];
  guard -> errors [label="reject"];
  created -> errors [label="unknown event"];
  shipped -> errors [label="final state"];
  cancelled -> errors [label="final state"];
}
